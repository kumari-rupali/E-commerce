rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Helper to check if a user is a seller
    function isSeller() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller';
    }

    // Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role']) &&
             data.keys().size() <= 12 &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.role == 'customer' &&
             (data.get('bonusPoints', 0) is number) &&
             (data.get('updatedAt', request.time) is timestamp || data.get('updatedAt', null) == null);
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'category', 'sellerId']) &&
             data.name is string && data.name.size() <= 100 &&
             data.price is number && data.price > 0 &&
             data.category is string && data.category.size() <= 50 &&
             data.sellerId == request.auth.uid &&
             (data.get('stock', 0) is number && data.get('stock', 0) >= 0) &&
             (data.get('createdAt', request.time) is timestamp || data.get('createdAt', null) == null);
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'items', 'total', 'status']) &&
             data.userId == request.auth.uid &&
             data.total is number && data.total >= 0 &&
             data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled'] &&
             data.items is list && data.items.size() > 0 &&
             (data.get('createdAt', request.time) is timestamp || data.get('createdAt', null) == null);
    }

    // 1. User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Users should not be listed
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'addresses', 'avatar', 'phone', 'is2FAEnabled', 'updatedAt', 'bonusPoints'])
      );
    }

    // 2. Products
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true; // Public listings
      allow create: if isSignedIn() && isSeller() && isValidProduct(incoming());
      allow update: if isSignedIn() && isOwner(existing().sellerId) && isValidProduct(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'price', 'category', 'image', 'stock', 'rating', 'reviewCount', 'updatedAt'])
      );
      allow delete: if isSignedIn() && isOwner(existing().sellerId);
    }

    // 3. Orders
    match /orders/{orderId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isSeller());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isSeller());
      allow create: if isSignedIn() && isValidOrder(incoming());
      allow update: if isSignedIn() && (
        // Customer can cancel if it's their own order and still pending
        (isOwner(existing().userId) && existing().status == 'pending' && incoming().diff(existing()).affectedKeys().hasOnly(['status']) && incoming().status == 'cancelled') ||
        // Seller can update status
        (isSeller() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
      );
    }
  }
}
